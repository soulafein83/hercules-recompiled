+#if defined(__ANDROID__)
+/* GLSL 330 -> ESSL 300 (Android only has OpenGL ES). This keeps one shader
+ * source set for both backends. Changes: version + the precision qualifiers ES
+ * requires; drop `noperspective` (not in ES 3.0 — ES defaults to smooth); drop
+ * the dual-source `blend_factor` output (ES 3.0 has no dual-source blending). */
+static char *adapt_shader_for_gles(const char *src) {
+    if (!src) return NULL;
+    const char *body = src;
+    const char *v = strstr(src, "#version 330");
+    if (v) {
+        const char *nl = strchr(v, '\n');
+        body = nl ? nl + 1 : v + strlen(v);
+    }
+    static const char header[] =
+        "#version 300 es\n"
+        "precision highp float;\n"
+        "precision highp int;\n"
+        "precision highp sampler2D;\n"
+        "precision highp usampler2D;\n";
+    static const char kBlendAssign[] = "blend_factor =";
+    static const char kBlendOut[] = "out vec4 blend_factor;";
+    static const char kNoPersp[] = "noperspective ";
+    size_t cap = strlen(header) + 2 * strlen(body) + 64;
+    char *out = (char *)malloc(cap);
+    if (!out) return NULL;
+    size_t n = 0;
+    memcpy(out, header, sizeof(header) - 1);
+    n = sizeof(header) - 1;
+    for (const char *s = body; *s; ) {
+        const char *eol = strchr(s, '\n');
+        size_t len = eol ? (size_t)(eol - s) : strlen(s);
+        const char *assign = strstr(s, kBlendAssign);
+        if (assign && assign < s + len) {
+            /* whole-line dual-source assignment: drop it */
+        } else {
+            for (size_t i = 0; i < len; i++) {
+                if (len - i >= sizeof(kNoPersp) - 1 &&
+                    memcmp(s + i, kNoPersp, sizeof(kNoPersp) - 1) == 0) {
+                    i += sizeof(kNoPersp) - 2;
+                    continue;
+                }
+                if (len - i >= sizeof(kBlendOut) - 1 &&
+                    memcmp(s + i, kBlendOut, sizeof(kBlendOut) - 1) == 0) {
+                    i += sizeof(kBlendOut) - 2;
+                    continue;
+                }
+                out[n++] = s[i];
+            }
+            out[n++] = '\n';
+        }
+        if (!eol) break;
+        s = eol + 1;
+    }
+    out[n] = '\0';
+    return out;
+}
+#endif
