diff --git a/runtime/src/gpu_vk_renderer.c b/runtime/src/gpu_vk_renderer.c
index 760b52f8..eb97cf28 100644
--- a/runtime/src/gpu_vk_renderer.c
+++ b/runtime/src/gpu_vk_renderer.c
@@ -868,6 +868,10 @@ static int create_swapchain(void) {
         ext.width = (uint32_t)w; ext.height = (uint32_t)h;
     }
     s_sc_extent = ext;
+    fprintf(stdout,
+            "psxrecomp: vulkan: swapchain %ux%u currentTransform=0x%x\n",
+            (unsigned)ext.width, (unsigned)ext.height,
+            (unsigned)caps.currentTransform);
 
     uint32_t img_count = caps.minImageCount + 1;
     if (caps.maxImageCount && img_count > caps.maxImageCount) img_count = caps.maxImageCount;
@@ -881,7 +885,21 @@ static int create_swapchain(void) {
     ci.imageArrayLayers = 1;
     ci.imageUsage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
     ci.imageSharingMode = VK_SHARING_MODE_EXCLUSIVE;
-    ci.preTransform = caps.currentTransform;
+    /* Android reports currentTransform=ROTATE_90 for a landscape app on a
+     * portrait-natural device, while caps.currentExtent is already in the app's
+     * (landscape) orientation. Advertising preTransform=currentTransform then
+     * makes the compositor rotate the upright image a second time (sideways
+     * picture). Prefer IDENTITY when the surface supports it; only fall back to
+     * currentTransform when it does not. */
+    VkSurfaceTransformFlagBitsKHR pre =
+        VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+    if (!(caps.supportedTransforms & VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR))
+        pre = caps.currentTransform;
+    ci.preTransform = pre;
+    fprintf(stdout,
+            "psxrecomp: vulkan: swapchain supportedTransforms=0x%x "
+            "chosenPreTransform=0x%x\n",
+            (unsigned)caps.supportedTransforms, (unsigned)pre);
     ci.compositeAlpha = VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
     ci.presentMode = choose_present_mode();
     ci.clipped = VK_TRUE;
